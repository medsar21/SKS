# Copier en .env.production. Ne jamais versionner le fichier rempli.
SKS_SITE_MODE=production
SITE_DOMAIN=www.votre-domaine.ma
POSTGRES_DB=sks
POSTGRES_USER=sks
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
# Encoder les caractères réservés du mot de passe dans cette URL.
DATABASE_URL=postgresql://sks:REMPLACER_PAR_UN_SECRET_ALEATOIRE@db:5432/sks
BETTER_AUTH_URL=https://www.votre-domaine.ma
BETTER_AUTH_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE
SKS_CATALOGUE_SOURCE=prisma
ALLOW_DEMO_SEED=false
ALLOW_DEV_SETUP=false
ALLOW_ADMIN_BOOTSTRAP=false
