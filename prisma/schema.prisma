generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  CUSTOMER
}

enum QuoteStatus {
  SUBMITTED
  DRAFT
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  developmentOnly Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  customer      Customer?
  auditLogs     AuditLog[]
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String   @id
  accountId              String
  providerId             String
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rateLimit")
}

model Customer {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName String
  email       String
  phone       String?
  city        String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      Quote[]
  orders      Order[]
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String    @default("")
  imageAlt    String    @default("")
  isDemo      Boolean   @default(false)
  products    Product[]
  revision    Int       @default(0)
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  slug        String   @unique
  name        String
  description String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("MAD") @db.Char(3)
  active      Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  details     Json?
  revision    Int      @default(0)
  @@index([categoryId, active])
}

model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactName String?
  companyName String?
  email       String?
  phone       String?
  city        String?
  siteAddress String?
  requestType String?
  rentalStart DateTime? @db.Date
  rentalEnd   DateTime? @db.Date
  submissionHash String?
  status      QuoteStatus @default(REQUESTED)
  currency    String      @default("MAD") @db.Char(3)
  validUntil  DateTime?
  notes       String?
  isDemo      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       QuoteLine[]
  order       Order?
  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([submissionHash, createdAt])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sku       String
  label     String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal? @db.Decimal(12, 2)
  taxRate   Decimal? @db.Decimal(5, 2)
  @@index([quoteId])
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId    String?     @unique
  quote      Quote?      @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  status     OrderStatus @default(PENDING)
  currency   String      @default("MAD") @db.Char(3)
  isDemo     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lines      OrderLine[]
  @@index([customerId, status])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String
  label     String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}

enum ContentKind {
  PAGE
  ARTICLE
  COPY
  SETTINGS
}

model ContentEntry {
  id          String @id @default(cuid())
  key         String @unique
  kind        ContentKind
  title       String
  summary     String @default("")
  body        Json
  published   Json?
  publishedAt DateTime?
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   ContentRevision[]
  @@index([kind, publishedAt])
}

model ContentRevision {
  id        String @id @default(cuid())
  entryId   String
  entry     ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  @@unique([entryId, version])
}

model MediaAsset {
  id        String @id @default(cuid())
  name      String
  alt       String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
