# PostgreSQL local uniquement ; remplacer les valeurs de remplacement.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sks?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
# Générer localement : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
# Activer uniquement pour peupler une base dédiée à la démonstration.
ALLOW_DEMO_SEED="false"
# Catalogue connecté : choisir prisma après migration et chargement explicite
# de produits actifs. demo conserve le catalogue public illustratif.
SKS_CATALOGUE_SOURCE="demo"
# Playwright PostgreSQL : base locale dédiée et compte de test existant.
# QUOTE_E2E="true"
# QUOTE_E2E_EMAIL=""
# QUOTE_E2E_PASSWORD=""
# QUOTE_E2E_PRODUCT_SLUG=""
# Provisionnement explicite d’identités aléatoires, jamais au démarrage ni au seed.
ALLOW_DEV_SETUP="false"
# Nom exact d’une base PostgreSQL locale dédiée (ne pas utiliser postgres/template*).
SKS_DEV_DATABASE=""
# dev:provision renseigne ces valeurs dans .env.local uniquement :
# DEV_ADMIN_ID, QUOTE_E2E_EMAIL, QUOTE_E2E_PASSWORD
# DEV_CUSTOMER_ID, QUOTE_E2E_CUSTOMER_EMAIL, QUOTE_E2E_CUSTOMER_PASSWORD
